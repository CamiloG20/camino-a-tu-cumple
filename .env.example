# === App (público, van en Vercel también) ===
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=media
# Solo desarrollo local (en Vercel la app usa el mismo dominio automáticamente):
EXPO_PUBLIC_ADMIN_API_URL=http://localhost:8787
EXPO_PUBLIC_BIRTHDAY_MONTH=8
EXPO_PUBLIC_BIRTHDAY_DAY=9
# Producción: https://camino-a-tu-cumple.vercel.app (opcional, ya es el default)
# EXPO_PUBLIC_SITE_URL=https://camino-a-tu-cumple.vercel.app

# === Web Push (iPhone PWA, recordatorio 10:00) ===
# Genera con: npm run generate:vapid
# EXPO_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-email@ejemplo.com
# CRON_SECRET=secreto-para-vercel-cron

# === Solo servidor local / scripts (NUNCA subir a git) ===
ADMIN_PASSWORD=elige-una-clave-segura
# Opcional: clave separada para firmar tokens admin (si no, usa ADMIN_PASSWORD)
# ADMIN_TOKEN_SECRET=otra-clave-larga-aleatoria
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Opcional (en Vercel no hace falta; previews y prod usan *.vercel.app):
# ADMIN_ALLOWED_ORIGIN=https://camino-a-tu-cumple.vercel.app

# === Postgres directo (opcional, solo scripts) ===
POSTGRES_PROJECT_REF=tu-project-ref
POSTGRES_PASSWORD=tu-password

# === Migración Firebase (opcional) ===
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
POSTGRES_URL_NON_POOLING=

# yt-dlp (solo admin local): Windows: winget install yt-dlp · macOS: brew install yt-dlp
