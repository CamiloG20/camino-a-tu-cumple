    "expo-updates": "~0.28.17",
    "react-dom": "19.0.0",
    "react-native-web": "^0.20.0",
    "@expo/metro-runtime": "~5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "firebase": "^11.10.0",
    "pg": "^8.16.0",
