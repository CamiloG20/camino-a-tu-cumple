  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web && npx workbox-cli generateSW workbox-config.js",
    "serve:web": "npx serve dist -s -l 3000",
    "deploy:vercel": "npm run build:web && npx vercel deploy --prebuilt --prod",
