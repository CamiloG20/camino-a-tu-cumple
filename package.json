    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "pg": "^8.16.0",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2",
    "vercel": "^54.21.0",
    "web-push": "^3.6.7",
