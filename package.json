    "setup:vercel-env": "node scripts/setup-vercel-env.mjs",
    "migrate:firebase": "node scripts/migrate-firebase-to-supabase.mjs",
    "migrate:supabase": "node scripts/migrate-supabase-project.mjs",
    "migrate:supabase:days": "node scripts/migrate-supabase-project.mjs --days-only",
    "setup:party-bel": "node scripts/setup-party-bel-schema.mjs",
    "assign:gifts": "node scripts/assign-gift-days.mjs",
    "verify:project": "node scripts/verify-project.mjs",
    "admin:server": "node server/admin-server.mjs",
    "dev:admin": "node server/admin-server.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
