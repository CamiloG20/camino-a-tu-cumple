    "setup:vercel-env": "node scripts/setup-vercel-env.mjs",
    "migrate:firebase": "node scripts/migrate-firebase-to-supabase.mjs",
    "migrate:supabase": "node scripts/migrate-supabase-project.mjs",
    "migrate:supabase:days": "node scripts/migrate-supabase-project.mjs --days-only",
    "setup:party-bel": "node scripts/setup-party-bel-schema.mjs",
    "setup:secure-rls": "node scripts/apply-secure-rls.mjs",
    "assign:gifts": "node scripts/assign-gift-days.mjs",
    "verify:project": "node scripts/verify-project.mjs",
    "clean:vercel-env": "node scripts/clean-vercel-env.mjs",
    "fix:day1-photo": "node scripts/fix-day1-photo.mjs",
    "admin:server": "node server/admin-server.mjs",
    "dev:admin": "node server/admin-server.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:vapid": "node scripts/generate-vapid-keys.mjs",
    "setup:push": "node scripts/setup-push-table.mjs",
    "setup:timezone": "node scripts/setup-timezone.mjs",
    "setup:notification-hour": "node scripts/setup-notification-hour.mjs",
    "setup:backgrounds": "node scripts/setup-backgrounds.mjs",
    "setup:unlocked-days": "node scripts/setup-unlocked-days-past.mjs",
    "test": "node scripts/run-tests.mjs",
